# Hydradb Bolt endpoint for the production CLI and Fastify API
HYDRADB_URI=bolt://localhost:7687
HYDRADB_USERNAME=neo4j
HYDRADB_AUTH_TOKEN=local-development-token-32-bytes

# Optional graph settings
AFTERSHOCK_FIXTURE=packages/graph/fixtures/packages.jsonl
AFTERSHOCK_SPREAD_SCALE=10
PORT=8787

# Optional Vercel build-time URL for the live Fastify API. Leave empty for the static demo.
VITE_AFTERSHOCK_API_URL=

# Optional Groq narration settings. The demo does not call Groq.
GROQ_API_KEY=REPLACE_WITH_GROQ_KEY
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
